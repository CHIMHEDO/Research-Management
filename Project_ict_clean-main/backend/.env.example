# Server Config
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here_super_secret

# MySQL Database Config
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workload_db

# MinIO Storage Config (Graceful fallback to local uploads/ directory if MinIO is offline)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin_minio
MINIO_SECRET_KEY=minio_password123
MINIO_BUCKET=research-papers

# GROBID Service Config (PDF parser)
GROBID_URL=http://localhost:8070

# Google Gemini AI Config (For Metadata Refinement & Author Role Identification)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Scholar Config (Optional: SerpApi key, fallback to scraper/mock if empty)
SERPAPI_KEY=

# Scholar Auto-sync Cron (Phase 2 - Optional, have safe defaults)
SCHOLAR_CRON_ENABLED=true
SCHOLAR_CRON_SCHEDULE=0 0 * * 0
SCHOLAR_PROVIDER=auto  # auto | serpapi | puppeteer | mock

# Microsoft Azure OAuth 2.0 Config
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# Microsoft 365 Outlook SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.ac.th
SMTP_PASS=your-email-password
SMTP_FROM=your-email@yourdomain.ac.th
